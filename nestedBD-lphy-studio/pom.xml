<project>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.Ming11110</groupId>
        <artifactId>nestedBD-root</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nestedBD-lphy-studio</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <name>nestedBD-lphy-studio</name>
    <description>LPhy Studio extension providing a viewer for the IntegerCharacterMatrix
    copy number type.</description>

<!--    <properties>-->
<!--        <maven.test.skip>true</maven.test.skip>-->
<!--    </properties>-->

    <dependencies>
        <dependency>
            <groupId>io.github.Ming11110</groupId>
            <artifactId>nestedBD-lphy</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>io.github.linguaphylo</groupId>
            <artifactId>lphy-studio</artifactId>
            <version>${lphy.vision}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/nestedBD-lphy-studio-assembly.xml</descriptor>
                    </descriptors>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <appendAssemblyId>false</appendAssemblyId>
                    <finalName>${project.artifactId}-${project.version}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id> <!-- this is used for inheritance merges -->
                        <phase>package</phase> <!-- bind to the packaging phase -->
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>